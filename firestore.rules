rules_version = '2';

// Anything not opened here is denied. Each later step opens one operation, as specified in docs/data-model.md.
service cloud.firestore {
  match /databases/{database}/documents {

    match /config/{docId} {
      allow read: if true;
    }

    match /drinks/{drinkId} {
      allow read: if true;
    }
  }
}
